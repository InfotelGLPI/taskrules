#: inc/rule.class.php:173
msgid "Prevent task creation on error"
msgstr "Empêcher la création de la tâche en cas d'erreur"

#: inc/rule.class.php:182
msgid ""
"Prevent the task from changing its status (from \"to do\" to \"done\") in "
"case of an error"
msgstr ""
"Empêcher le changement de statut (de \"à faire\" à \"fait\") de la tâche en "
"cas d'erreur"

#: inc/rule.class.php:202
msgid "Activate when a task is added to the ticket"
msgstr "Déclencher à l'ajout de la tâche dans le ticket"

#: inc/rule.class.php:211
msgid "Trigger upon updating the task status from \"to do\" to \"done\""
msgstr ""
"Déclencher à la mise à jour du statut de la tâche de \"à faire\" vers \"fait"
"\""

#: inc/rule.class.php:234 inc/rule.class.php:270 inc/rule.class.php:306
#: inc/rule.class.php:319 inc/rule.class.php:333
msgid "Do not change"
msgstr "Ne pas modifier"

#: inc/rule.class.php:235 inc/rule.class.php:271 inc/rule.class.php:307
#: inc/rule.class.php:320 inc/rule.class.php:334
msgid "Empty the field on the linked item of ticket"
msgstr "Vider le champ sur les objets liés au ticket"

#: inc/rule.class.php:236
msgid "Affect a specific state on the linked item of ticket"
msgstr "Affecter un statut spécifique sur les objets liés au ticket"

#: inc/rule.class.php:260
msgid ""
"Please note, only the statuses common to the objects selected in the "
"conditions appear"
msgstr ""
"Attention, n'apparaissent que les statuts communs aux objets sélectionnés "
"dans les conditions"

#: inc/rule.class.php:272
msgid "Affect location of ticket requester on the linked item of ticket"
msgstr "Affecter le lieu du demandeur du ticket sur les objets liés au ticket"

#: inc/rule.class.php:273
msgid "Affect a specific location on the linked item of ticket"
msgstr "Affecter un lieu spécifique sur les objets liés au ticket"

#: inc/rule.class.php:321
msgid "Affect ticket requester on the linked item of ticket"
msgstr ""
"Affecter le demandeur du ticket comme utilisateur sur les objets liés au "
"ticket"

#: inc/rule.class.php:335
msgid "Affect group of the ticket requester on the linked item of ticket"
msgstr ""
"Affecter le groupe demandeur du ticket comme groupe sur les objets liés au "
"ticket"

