{# One criterion of a condition search (Condition::renderCriteria()). The widgets (link /
   field selectors, search option of the core and its reload script) are rendered by the core
   in return mode and output raw; hidden fields are name => value; the row id is alphanumeric. #}
<div class="list-group-item {{ padding }} border-0 normalcriteria{{ header_class }}" id="{{ rowid }}">
    <div class="row g-1">
        {% if not from_meta %}
            {% for name, value in hidden_fields %}
                <input type="hidden" name="{{ name }}" id="{{ name }}" value="{{ value }}">
            {% endfor %}
            <div class="col-auto">
                <button class="btn btn-sm btn-icon btn-ghost-secondary remove-search-criteria" type="button"
                        data-rowid="{{ rowid }}" data-bs-toggle="tooltip" data-bs-placement="left"
                        title="{{ __('Delete a rule') }}">
                    <i class="ti ti-square-minus"></i>
                </button>
            </div>
            <div class="col-auto">{{ link_dropdown|raw }}</div>
        {% endif %}
        <div class="col-auto">{{ field_dropdown|raw }}</div>
        <div class="col-auto">
            <div class="row g-1" id="{{ spanid }}">
                {{ search_option|raw }}
            </div>
            {{ update_script|raw }}
        </div>
    </div>
</div>
