{# Group of criteria of a condition search (Condition::renderCriteriaGroup()): the link
   selector and the nested search, both pre-rendered, output raw. #}
<div class="list-group-item p-2 border-0 normalcriteria{{ header_class }}" id="{{ rowid }}">
    <div class="row g-1">
        <div class="col-auto">
            <button class="btn btn-sm btn-icon btn-ghost-secondary remove-search-criteria" type="button"
                    data-rowid="{{ rowid }}" data-bs-toggle="tooltip" data-bs-placement="left"
                    title="{{ __('Delete a rule') }}">
                <i class="ti ti-square-minus"></i>
            </button>
        </div>
        <div class="col-auto">{{ link_dropdown|raw }}</div>
        <div class="col-auto">{{ search|raw }}</div>
    </div>
</div>
