{% if not_found_rows is not empty %}
    <div class="alert alert-danger">{{ __('Items not updated (not match with rule)', 'taskrules') }}</div>
    <table class="tab_cadre_fixe">
        {% for row in not_found_rows %}
            <tr class="tab_bg_2">
                <td width="20%"><i class="ti ti-circle-x" style="color: red;"></i></td>
                <td>{{ row.type_name }}</td>
                <td>{{ row.link|raw }}</td>
                <td>{{ row.serial }}</td>
            </tr>
        {% endfor %}
    </table>
    <br>
{% endif %}

{% if no_right_rows is not empty %}
    <div class="alert alert-warning">{{ __('Items not updated (insufficient rights)', 'taskrules') }}</div>
    <table class="tab_cadre_fixe">
        {% for row in no_right_rows %}
            <tr class="tab_bg_2">
                <td width="20%"><i class="ti ti-lock" style="color: orange;"></i></td>
                <td>{{ row.type_name }}</td>
                <td>{{ row.link|raw }}</td>
                <td>{{ row.serial }}</td>
            </tr>
        {% endfor %}
    </table>
    <br>
{% endif %}

{% if updated_blocks is not empty %}
    <div class="alert alert-success">{{ __('Items updated', 'taskrules') }}</div>
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_2">
            <td>
                {% for block in updated_blocks %}
                    <table class="tab_cadre_fixe">
                        {% for group in block.groups %}
                            <tr class="tab_bg_2">
                                <th width="20%">{{ group.type_name }}</th>
                                <th>{{ group.link|raw }}</th>
                                <th>{{ group.serial }}</th>
                            </tr>
                            {% for action in group.actions %}
                                <tr class="tab_bg_2">
                                    <td>{{ action.action_name }}</td>
                                    <td>{{ action.action_type }}</td>
                                    <td>
                                        {% if action.result.done %}<i class="ti ti-check" style="color: forestgreen;"></i>{% endif %}
                                        {% for error in action.result.errors %}
                                            <i class="ti ti-circle-x" style="color: red;"></i>&nbsp;<span style="color:red">{{ error }}</span><br>
                                        {% endfor %}
                                        {{ action.result.value }}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </table>
                {% endfor %}
            </td>
        </tr>
    </table>
{% endif %}
