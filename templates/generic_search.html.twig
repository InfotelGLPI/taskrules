<div class="{{ card_class }}"{% if folded %} style="display: none;"{% endif %}>
    <div id="searchcriteria{{ rand_criteria }}" class="{{ main_block_class }}">
        {{ nbcount_script|raw }}
        <div class="list-group list-group-flush list-group-hoverable criteria-list pt-2" id="{{ criteria_table_id }}">
            {{ criteria_rows|raw }}
            <a id="more-criteria{{ rand_criteria }}" role="button"
               class="normalcriteria fold-search list-group-item p-2 border-0"
               style="display: none;"></a>
        </div>

        <div class="card-footer d-flex search_actions">
            <button id="addsearchcriteria{{ rand_criteria }}" class="btn btn-sm btn-outline-secondary me-1" type="button">
                <i class="ti ti-square-plus"></i>
                <span class="d-none d-sm-block">{{ __('rule') }}</span>
            </button>
            <button id="addcriteriagroup{{ rand_criteria }}" class="btn btn-sm btn-outline-secondary me-1" type="button">
                <i class="ti ti-code-plus"></i>
                <span class="d-none d-sm-block">{{ __('group') }}</span>
            </button>
        </div>

        {{ js_script|raw }}
        {{ hidden_fields|raw }}
    </div>
</div>
