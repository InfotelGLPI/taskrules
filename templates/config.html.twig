<table class="tab_cadre_fixe">
    <tr class="tab_bg_2">
        <th colspan="2">{{ _n('Task rule', 'Task rules', 2, 'taskrules') }}</th>
    </tr>
    <tr class="tab_bg_2">
        <td>
            <a href="{{ log_url }}">{{ __('See logs', 'taskrules') }}</a>
        </td>
        <td>
            {% if can_purge %}
                <form method="post" action="{{ purge_target }}">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    {{ call('Html::submit', [__('Drop logs', 'taskrules'), {
                        'name': 'purge',
                        'class': 'btn btn-outline-danger',
                        'confirm': __('Confirm the definitive deletion of all logs?', 'taskrules'),
                    }])|raw }}
                </form>
            {% else %}
                &nbsp;
            {% endif %}
        </td>
    </tr>
</table>
