<table class="tab_cadre_fixe">
    <tr class="tab_bg_2">
        <th colspan="2">{{ _n('Task rule', 'Task rules', 2, 'taskrules') }}</th>
    </tr>
    <tr class="tab_bg_2">
        <td>
            <a href="{{ log_url }}">{{ __('See logs', 'taskrules') }}</a>
        </td>
        <td>
            {% if can_purge %}
                <form method="post" action="{{ purge_target }}">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    {{ call('Html::submit', [__('Drop logs', 'taskrules'), {
                        'name': 'purge',
                        'class': 'btn btn-outline-danger',
                        'confirm': __('Confirm the definitive deletion of all logs?', 'taskrules'),
                    }])|raw }}
                </form>
            {% else %}
                &nbsp;
            {% endif %}
        </td>
    </tr>
</table>

{#
 # Profiles that may only update the assets through the task rules (AssetRestriction).
 #
 # config_target       - this controller
 # profiles            - id => name of every profile
 # restricted_profiles - ids of the profiles currently restricted
 # restricted_types    - names of the asset types concerned (Condition::$types)
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="post" action="{{ config_target }}" class="card mt-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-lock me-2"></i>{{ __('Updates of the assets restricted to the task rules', 'taskrules') }}
        </h3>
    </div>
    <div class="card-body row">
        <div class="col-12 mb-3 text-muted">
            {{ __('The selected profiles keep the right to update these assets so that the task rules can apply their actions, but they can no longer update them in any other way (form, massive actions, API, sub items).', 'taskrules') }}
            <br>
            <strong>{{ __('Asset types', 'taskrules') }}</strong> : {{ restricted_types|join(', ') }}
        </div>
        {{ fields.dropdownArrayField(
            'restricted_profiles',
            null,
            profiles,
            __('Restricted profiles', 'taskrules'),
            {'values': restricted_profiles, 'multiple': true, 'full_width': true}
        ) }}
    </div>
    <div class="card-footer text-end">
        <button type="submit" name="update_restrictions" value="1" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
        </button>
    </div>
</form>
