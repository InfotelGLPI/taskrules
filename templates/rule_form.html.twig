{# jQuery UI (accordion of the form), tags built by the core asset helpers #}
{{ call('Html::css', [webdir ~ '/lib/jquery-ui/jquery-ui.min.css'])|raw }}
{{ call('Html::script', [webdir ~ '/lib/jquery-ui/jquery-ui.min.js'])|raw }}

<form name="form" method="post" action="{{ target }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_2">
            <td class="top">
                <input type="hidden" name="tasktemplates_id" value="{{ tasktemplates_id }}">
                <input type="hidden" name="id" value="{{ id }}">
                <input type="hidden" name="groupIndex" value="0">
                <input type="hidden" name="boolUpdStatuses" value="0">

                <div id="accordion_rules">
                    <h3><a href="#">{{ _n('Parameter', 'Parameters', 2, 'taskrules') }}</a></h3>
                    {{ include('@taskrules/rule/settings_table.html.twig', {rows: parameters_rows}) }}

                    <h3><a href="#">{{ _n('Condition', 'Conditions', 2, 'taskrules') }}</a></h3>
                    {# Rendered by Condition::renderCriteriasForm() from the search templates #}
                    {{ criterias_form|raw }}

                    <h3><a href="#">{{ _n('Trigger', 'Triggers', 2, 'taskrules') }}</a></h3>
                    {{ include('@taskrules/rule/settings_table.html.twig', {rows: triggers_rows}) }}

                    <h3><a href="#">{{ _n('Action', 'Actions', 2, 'taskrules') }}</a></h3>
                    {{ include('@taskrules/rule/settings_table.html.twig', {rows: actions_rows}) }}
                </div>
                {# The accordion is started by public/scripts/rule_form.js #}
            </td>
        </tr>
        <tr class="tab_bg_1">
            <td class="center" colspan="2">
                {% if id > 0 %}
                    {{ call('Html::submit', [_x('button', 'Update'), {'name': 'update', 'class': 'btn btn-primary'}])|raw }}
                {% else %}
                    {{ call('Html::submit', [_x('button', 'Add'), {'name': 'add', 'class': 'btn btn-primary'}])|raw }}
                {% endif %}
            </td>
        </tr>
    </table>
</form>
