{# On/off switch of a rule setting (Rule::renderSwitchField()): the hidden input carries the
   value, public/scripts/rule_form.js toggles it with the icon. #}
<input type="hidden" name="{{ name }}" id="{{ id }}" value="{{ value ? 1 : 0 }}">
<a class="button" role="button" data-taskrules-switch="{{ id }}">
    <i class="fa-fw fas fa-2x {{ value ? 'fa-toggle-on enabled' : 'fa-toggle-off disabled' }}"></i>
</a>
