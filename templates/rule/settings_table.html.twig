{# Two-column settings table of the rule form (parameters, triggers, actions), built from data
   (Rule::getParametersRows() / getTriggersRows() / getActionsRows()):
   - switch: an on/off switch (rule/switch.html.twig);
   - widget: a selector of the core, rendered in return mode, output raw (the core escapes it);
     with "specific", the container its reload script fills (ajax/updateactionsdropdowns.php),
     holding the current specific selector, also rendered by the core.
   An optional note fills a third cell. #}
<div>
    <table class="" width="100%">
        {% for row in rows %}
            <tr class="tab_bg_2">
                <td>{{ row.label }}</td>
                <td>
                    {% if row.type == 'switch' %}
                        {{ include('@taskrules/rule/switch.html.twig', row.switch) }}
                    {% else %}
                        {{ row.widget|raw }}
                        {% if row.specific is defined %}
                            &nbsp;<span id="{{ row.specific.id }}">{{ row.specific.widget|raw }}</span>
                        {% endif %}
                    {% endif %}
                </td>
                {% if row.note is defined %}
                    <td><div class="left">{{ row.note }}</div></td>
                {% endif %}
            </tr>
        {% endfor %}
    </table>
</div>
